# Copy to .env.local (never commit it).

# Live guide generation needs ONE of these keys. Without either, the curated library still works
# and the Generate button explains that live generation is off.

# Free option: Google Gemini (get a key at https://aistudio.google.com, no credit card).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_RESEARCH_MODE=self      # default: the server searches + downloads pages (works on the free tier)
# GEMINI_RESEARCH_MODE=grounding # Google Search tool instead (not included in the free tier for current models)

# Paid option: Anthropic Claude.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# If both keys are set, Anthropic is used unless you force one: COMPASS_PROVIDER=gemini | anthropic

# Optional: durable storage for generated guides on serverless hosts (Upstash Redis REST).
# Without these, guides are saved to ./.data/guides locally, or to /tmp on Vercel (temporary).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: custom directory for file storage.
# COMPASS_DATA_DIR=

# Optional abuse limits (per server instance): generations per IP per 10 minutes, and concurrent runs.
# COMPASS_RATE_LIMIT=6
# COMPASS_MAX_CONCURRENT=3

# Test only. Replays a scripted, clearly labelled fixture instead of calling the model.
# Never set this in a real deployment.
# COMPASS_AGENT_MODE=fixture
